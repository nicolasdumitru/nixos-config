# theme = Dark Modern
theme = Ghostty Default Style Dark
# theme = Hardcore
# theme = Nvim Dark
window-colorspace = srgb
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor
font-feature = -calt, -liga, -dlig

keybind = ctrl+backspace=text:\x17
# Vim-like jumps between prompts (overrides the default ctrl+shift+j, which
# pastes the screen contents as a file). The ctrl+shift+arrow defaults remain.
keybind = ctrl+shift+k=jump_to_prompt:-1
keybind = ctrl+shift+j=jump_to_prompt:1

background-opacity = 1.0
background-blur = true